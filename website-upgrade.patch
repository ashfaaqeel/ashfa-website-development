diff --git a/lib/db/migrations/0001_images_and_contact.sql b/lib/db/migrations/0001_images_and_contact.sql
new file mode 100644
index 0000000..aeca500
--- /dev/null
+++ b/lib/db/migrations/0001_images_and_contact.sql
@@ -0,0 +1,24 @@
+-- Additive, idempotent migration. Does not touch the existing site_content table.
+-- Equivalent to running: pnpm --filter @workspace/db run push
+
+CREATE TABLE IF NOT EXISTS uploaded_images (
+  id           text PRIMARY KEY,
+  content_type text NOT NULL,
+  data         bytea NOT NULL,
+  size         integer NOT NULL,
+  created_at   timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE TABLE IF NOT EXISTS contact_messages (
+  id          serial PRIMARY KEY,
+  name        text NOT NULL,
+  email       text NOT NULL,
+  message     text NOT NULL,
+  ip_hash     text NOT NULL DEFAULT '',
+  emailed     boolean NOT NULL DEFAULT false,
+  email_error text,
+  created_at  timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE INDEX IF NOT EXISTS contact_messages_ip_created_idx
+  ON contact_messages (ip_hash, created_at);
diff --git a/lib/db/src/schema/contact-messages.ts b/lib/db/src/schema/contact-messages.ts
new file mode 100644
index 0000000..57d7c42
--- /dev/null
+++ b/lib/db/src/schema/contact-messages.ts
@@ -0,0 +1,28 @@
+import {
+  boolean,
+  index,
+  pgTable,
+  serial,
+  text,
+  timestamp,
+} from "drizzle-orm/pg-core";
+
+export const contactMessagesTable = pgTable(
+  "contact_messages",
+  {
+    id: serial("id").primaryKey(),
+    name: text("name").notNull(),
+    email: text("email").notNull(),
+    message: text("message").notNull(),
+    /** SHA-256 of the sender IP + secret, used only for rate limiting. */
+    ipHash: text("ip_hash").notNull().default(""),
+    emailed: boolean("emailed").notNull().default(false),
+    emailError: text("email_error"),
+    createdAt: timestamp("created_at", { withTimezone: true })
+      .notNull()
+      .defaultNow(),
+  },
+  (table) => [index("contact_messages_ip_created_idx").on(table.ipHash, table.createdAt)],
+);
+
+export type ContactMessageRecord = typeof contactMessagesTable.$inferSelect;
