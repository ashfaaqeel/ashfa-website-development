@@ -0,0 +1,54 @@
+import { logger } from "./logger";
+
+export type EmailResult = { sent: boolean; error: string | null };
+
+const escapeHtml = (value: string) =>
+  value
+    .replaceAll("&", "&amp;")
+    .replaceAll("<", "&lt;")
+    .replaceAll(">", "&gt;")
+    .replaceAll('"', "&quot;");
+
+/**
+ * Delivers a contact-form message to the site owner through the Resend HTTP API.
+ * Needs RESEND_API_KEY and CONTACT_TO_EMAIL. Without them nothing is sent, and the
+ * message is still kept in the database and shown in the private editor.
+ */
+export async function sendContactEmail(input: {
+  name: string;
+  email: string;
+  message: string;
+}): Promise<EmailResult> {
+  const apiKey = process.env.RESEND_API_KEY?.trim();
+  const to = process.env.CONTACT_TO_EMAIL?.trim();
+  if (!apiKey || !to) {
+    return { sent: false, error: "Email delivery is not configured (RESEND_API_KEY / CONTACT_TO_EMAIL)." };
+  }
+  const from = process.env.CONTACT_FROM_EMAIL?.trim() || "Website contact <onboarding@resend.dev>";
+  const safeName = input.name.replace(/[\r\n]+/g, " ").trim();
+
+  try {
+    const response = await fetch(process.env.RESEND_API_URL?.trim() || "https://api.resend.com/emails", {
+      method: "POST",
+      headers: { Authorization: `Bearer ${apiKey}`, "Content-Type": "application/json" },
+      body: JSON.stringify({
+        from,
+        to: [to],
+        reply_to: input.email,
+        subject: `New message from ${safeName}`.slice(0, 150),
+        text: `From: ${safeName} <${input.email}>\n\n${input.message}`,
+        html: `<p><strong>${escapeHtml(safeName)}</strong> &lt;${escapeHtml(input.email)}&gt;</p><p style="white-space:pre-wrap">${escapeHtml(input.message)}</p>`,
+      }),
+      signal: AbortSignal.timeout(8000),
+    });
+    if (!response.ok) {
+      const detail = (await response.text().catch(() => "")).slice(0, 300);
+      logger.error({ status: response.status }, "Contact email provider rejected the request");
+      return { sent: false, error: `Email provider error ${response.status}: ${detail}` };
+    }
+    return { sent: true, error: null };
+  } catch (error) {
+    logger.error({ err: error }, "Contact email request failed");
+    return { sent: false, error: error instanceof Error ? error.message : "Email request failed." };
+  }
+}
diff --git a/artifacts/api-server/src/routes/contact.ts b/artifacts/api-server/src/routes/contact.ts
new file mode 100644
index 0000000..04f132c
--- /dev/null
+++ b/artifacts/api-server/src/routes/contact.ts
@@ -0,0 +1,108 @@
+import { createHash } from "node:crypto";
+import { and, count, desc, eq, gte } from "drizzle-orm";
+import { Router, type IRouter } from "express";
+import {
+  ListContactMessagesResponse,
+  SendContactMessageBody,
+  SendContactMessageResponse,
+  DeleteContactMessageResponse,
+} from "@workspace/api-zod";
+import { contactMessagesTable, db } from "@workspace/db";
+import { requireAdmin } from "./auth";
+import { sendContactEmail } from "../lib/email";
+import { logger } from "../lib/logger";
+
+const router: IRouter = Router();
+const WINDOW_MS = 60 * 60 * 1000;
+const MAX_PER_SENDER = 5;
+const MAX_TOTAL = 100;
+
+function senderHash(ip: string): string {
+  return createHash("sha256")
+    .update(`${ip}|${process.env.SESSION_SECRET ?? "contact"}`)
+    .digest("hex");
+}
+
+router.post("/contact", async (req, res): Promise<void> => {
+  const parsed = SendContactMessageBody.safeParse(req.body);
+  if (!parsed.success) {
+    res.status(400).json({ error: "Please enter your name, a valid email and a message of at least 10 characters." });
+    return;
+  }
+  const { email, message, website } = parsed.data;
+  const name = parsed.data.name.replace(/\s+/g, " ").trim();
+
+  // Honeypot: real visitors never see or fill this field. Pretend success to bots.
+  if (website && website.trim() !== "") {
+    res.json(SendContactMessageResponse.parse({ ok: true }));
+    return;
+  }
+
+  const ipHash = senderHash(req.ip || req.socket.remoteAddress || "unknown");
+  const since = new Date(Date.now() - WINDOW_MS);
+
+  try {
+    const [sender] = await db
+      .select({ value: count() })
+      .from(contactMessagesTable)
+      .where(and(eq(contactMessagesTable.ipHash, ipHash), gte(contactMessagesTable.createdAt, since)));
+    const [total] = await db
+      .select({ value: count() })
+      .from(contactMessagesTable)
+      .where(gte(contactMessagesTable.createdAt, since));
+    if ((sender?.value ?? 0) >= MAX_PER_SENDER || (total?.value ?? 0) >= MAX_TOTAL) {
+      res.status(429).json({ error: "Too many messages just now. Please try again later." });
+      return;
+    }
+
+    const [saved] = await db
+      .insert(contactMessagesTable)
+      .values({ name, email: email.trim(), message: message.trim(), ipHash })
+      .returning({ id: contactMessagesTable.id });
+
+    const result = await sendContactEmail({ name, email: email.trim(), message: message.trim() });
+    if (saved) {
+      await db
+        .update(contactMessagesTable)
+        .set({ emailed: result.sent, emailError: result.error })
+        .where(eq(contactMessagesTable.id, saved.id));
+    }
+    res.json(SendContactMessageResponse.parse({ ok: true }));
+  } catch (error) {
+    logger.error({ err: error }, "Contact message failed");
+    res.status(500).json({ error: "Your message could not be sent. Please try again in a moment." });
+  }
+});
+
+router.get("/admin/messages", requireAdmin, async (_req, res): Promise<void> => {
+  const rows = await db
+    .select()
+    .from(contactMessagesTable)
+    .orderBy(desc(contactMessagesTable.createdAt))
+    .limit(200);
+  res.json(
+    ListContactMessagesResponse.parse(
+      rows.map((row) => ({
+        id: row.id,
+        name: row.name,
+        email: row.email,
+        message: row.message,
+        createdAt: row.createdAt.toISOString(),
+        emailed: row.emailed,
+        emailError: row.emailError,
+      })),
+    ),
+  );
+});
+
+router.delete("/admin/messages/:id", requireAdmin, async (req, res): Promise<void> => {
+  const id = Number(req.params.id);
+  if (!Number.isInteger(id) || id <= 0) {
+    res.status(400).json({ error: "Invalid message id." });
+    return;
+  }
+  await db.delete(contactMessagesTable).where(eq(contactMessagesTable.id, id));
+  res.json(DeleteContactMessageResponse.parse({ ok: true }));
+});
+
+export default router;
