@@ -0,0 +1,24 @@
+import { useEffect, useState } from 'react';
+
+const TIME_ZONE = 'Asia/Kolkata';
+const formatter = new Intl.DateTimeFormat('en-US', {
+  timeZone: TIME_ZONE,
+  hour: 'numeric',
+  minute: '2-digit',
+  second: '2-digit',
+  hour12: true,
+});
+
+/** Live clock in India Standard Time. Ticks every second and cleans up on unmount. */
+export function LiveClock() {
+  const [now, setNow] = useState(() => new Date());
+  useEffect(() => {
+    const timer = window.setInterval(() => setNow(new Date()), 1000);
+    return () => window.clearInterval(timer);
+  }, []);
+  return (
+    <time className="live-clock" dateTime={now.toISOString()} data-testid="text-footer-time">
+      {formatter.format(now)} IST
+    </time>
+  );
+}
diff --git a/artifacts/ashfa-aqeel-website/src/components/markdown-textarea.tsx b/artifacts/ashfa-aqeel-website/src/components/markdown-textarea.tsx
new file mode 100644
